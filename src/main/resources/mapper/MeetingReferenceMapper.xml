<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.teamproject.meeting.mapper.MeetingReferenceMapper">
    <insert id="createMeeting" useGeneratedKeys="true" keyProperty="referenceId">
    	INSERT INTO MEETINGREFERENCE (meetingId, referenceUrl)
    	VALUES (#{meetingId}, #{referenceUrl})
    </insert>
    
    <select id="findByMeetingId" resultType="com.teamproject.meeting.dto.meetingParticipant.MeetingDetailResDto$Reference">
    	SELECT reference_id, reference_url
    	FROM meeting_reference
    	WHERE meeting_id = #{meetingId}
	</select>
	
	<select id="findMeetingIdByReferenceId" resultType="long">
		SELECT meeting_id
		FROM meeting_reference
		WHERE reference_id = #{referenceId}
	</select>
	
	<delete id="deleteById">
		DELETE FROM meeting_reference
		WHERE reference_id = #{referenceId}
	</delete>
</mapper>