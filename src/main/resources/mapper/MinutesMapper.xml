<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.teamproject.meeting.mapper.Minutes">
    <insert id ="createMeeting" useGeneratedKeys="true" keyProperty="minutesId">
    	INSERT INTO MINUTES (meetingId, minutesUrl)
    	VALUES (#{meetingId}, #{minutesUrl})
    </insert>
    
    <select id="findByMeetingId" resultType="com.teamproject.meeting.dto.meetingParticipant.MeetingDetailResDto$Minutes">
    	SELECT minutes_id, minutes_url
    	FROM minutes
    	WHERE meeting_id = #{meetingId}
	</select>
	
	<select id="findMeetingIdByMinutesId" resultType="long">
		SELECT meeting_id
		FROM minutes
		WHERE minutes_id = #{minutesId}
	</select>
	
	<delete id="deleteById">
		DELETE FROM minutes
		WHERE minutes_id = #{minutesId}
	</delete>
</mapper>